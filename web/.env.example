# ── Base de dados ────────────────────────────────────────────────────────
# Local (Docker, ver docker-compose.yml na raiz). Em produção: Supabase/Neon.
DATABASE_URL="postgresql://decifra:decifra@localhost:5432/decifra"

# ── IA (camada de explicação/normalização, sempre ancorada em fontes) ──────
# ANTHROPIC_API_KEY=""

# ── Dados de produto ───────────────────────────────────────────────────────
# GO_UPC_API_KEY=""        # identidade por EAN
# ICECAT_USERNAME=""       # specs (Open Icecat é grátis)
# AWIN_PUBLISHER_ID=""     # feeds de afiliado

# ── Preço live (§3, SÓ on-demand pelo botão "atualizar") ───────────────────
# Escolhe UMA fonte (a mais barata por consulta). Sem isto, o botão degrada
# com mensagem clara. Lidas pela route /api/price/refresh.
# DATAFORSEO_LOGIN=""      # recomendado (mais barato por consulta)
# DATAFORSEO_PASSWORD=""
# BRIGHTDATA_TOKEN=""      # alternativa
# SERPAPI_KEY=""           # alternativa

# ── Cache / rate limit (Upstash) ───────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
