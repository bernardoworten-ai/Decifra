ICECAT_APP_KEY=""        # specs: necessário para conteúdo Full Icecat (Icecat › "Meu Perfil")
AWIN_FEED_URL=""         # ofertas: URL do product feed Awin (com a tua publisher key)
SERPAPI_KEY=""           # preço live on-demand (fase seguinte)
