# Mesmo Postgres da app web (docker-compose na raiz, ou Supabase/Neon).
DATABASE_URL="postgresql://decifra:decifra@localhost:5432/decifra"

# IA (explicação/normalização/resumos — sempre ancorada em fontes)
ANTHROPIC_API_KEY=""

# Fontes de dados
